{
  "manifest_version": 3,
  "name": "KAVACH Guard",
  "version": "0.2.0",
  "description": "Privacy-first local phishing and scam detection companion for KAVACH AI.",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KAVACH Guard"
  }
}