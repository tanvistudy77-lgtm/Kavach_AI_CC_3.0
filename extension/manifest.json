
{
  "manifest_version": 3,
  "name": "KAVACH Guard",
  "version": "0.3.0",
  "description": "Privacy-first phishing detection and automatic browser protection.",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KAVACH Guard"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kavach_rules",
        "enabled": true,
        "path": "block-rules.json"
      }
    ]
  }
}
